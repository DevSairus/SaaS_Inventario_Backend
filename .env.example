NODE_ENV=development
PORT=5000

# Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pitbox_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_use_a_random_64_byte_hex_string
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# ── Brevo (Email, vía API HTTP) ──────────
# API Key: panel Brevo → SMTP & API → API Keys → Generate a new API key
# Usamos la API HTTP (no SMTP) porque algunos hosts (ej. Railway) bloquean
# la salida por puertos SMTP.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=notificaciones@your_verified_domain
EMAIL_FROM_NAME=Control de Inventario
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
