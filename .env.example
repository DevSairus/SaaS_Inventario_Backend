NODE_ENV=development
PORT=5000

# Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pitbox_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_use_a_random_64_byte_hex_string
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# ── Brevo (Email, vía API HTTP) ──────────
# API Key: panel Brevo → SMTP & API → API Keys → Generate a new API key
# Usamos la API HTTP (no SMTP) porque algunos hosts (ej. Railway) bloquean
# la salida por puertos SMTP.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=notificaciones@your_verified_domain
EMAIL_FROM_NAME=Control de Inventario
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback automático de NEXA si Groq falla (opcional, pero recomendado en producción)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5

# Segundo fallback de NEXA si Groq y Claude fallan (opcional)
# API Key: https://mimo.mi.com → Console → API Keys (pay-as-you-go, sk-xxxxx)
# Si en cambio usas Token Plan, deja MIMO_BASE_URL con el Base URL exclusivo
# que te da la consola tras suscribirte (y tu key será tp-xxxxx).
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Cron jobs -- protege /api/cron/* (vehicle-reminders, stock-alerts,
# ncf-sync). Sin esto, en producción esos endpoints devuelven 401 -- a
# propósito, así solo tu Cron Job de Railway (o el servicio externo que
# uses) los puede disparar. openssl rand -hex 32
CRON_SECRET=

# Jobs programados (vehicle-reminders, stock-alerts, ncf-sync) -- corren
# solos dentro de este mismo proceso (ver src/jobs/scheduler.js), no
# necesitan nada configurado aparte en Railway. Ponlo en "false" solo si
# vas a disparar esos mismos jobs desde un Railway Cron Job o un servicio
# externo -- así no corren dos veces.
ENABLE_CRON_SCHEDULER=true

# Cuántos días antes de next_billing_date se genera la prefactura NCF de
# cada tenant (por defecto 7 -- ver ncfSyncService.js)
NCF_ANTICIPATION_DAYS=7

# Días de gracia DESPUÉS de next_billing_date antes de suspender el
# servicio por impago (por defecto 2). La reactivación es automática al
# confirmarse el pago -- no requiere ninguna acción manual.
NCF_SUSPENSION_GRACE_DAYS=2

# URL pública de este backend -- el Núcleo NCF la necesita para saber a
# dónde mandar los webhooks (invoice.issued, prefactura.paid, etc.)
BACKEND_PUBLIC_URL=https://TU-BACKEND-PITBOX.up.railway.app

# Servicio DIAN remoto (microservicio propio en Hostinger, con IP
# colombiana) -- evita el problema de IP extranjera contra el webservice
# de la DIAN. Ya se usaba en el código (dianKitAdapter.js) pero nunca
# había quedado documentado acá.
DIAN_SERVICE_URL=
DIAN_API_KEY=
