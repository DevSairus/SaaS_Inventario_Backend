{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/vehicle-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/stock-alerts",
      "schedule": "0 * * * *"
    }
  ]
}